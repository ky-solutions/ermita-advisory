# Prévisualisation non indexable par défaut. Domaine HTTPS réel requis.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=false
# Envoi Resend : expéditeur autorisé sur un domaine vérifié.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Compteur partagé Upstash Redis, requis pour activer le formulaire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# À définir seulement si le proxy d’hébergement écrase ce header.
# Sans header fiable, compteur global de 5 demandes / 10 min.
TRUSTED_IP_HEADER=


# Coordonnées publiques, à confirmer avant affichage.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# CSP bloquante par défaut. true uniquement pour un diagnostic report-only.
CSP_REPORT_ONLY=false
